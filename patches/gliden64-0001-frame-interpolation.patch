+// ---------------------------------------------------------------------------
+// Frame interpolation (Wave Race 64: Recompiled PortMaster port)
+//
+// The host renders a game frame's display list several times per game frame
+// and asks for in-between frames: every matrix the display list loads is
+// replaced by a blend of the same load (paired by its index in the display
+// list) in the previous game frame and in this one. Geometry always comes
+// from the current frame; only transforms move. Loads that cannot be paired
+// (different count or kind than the previous frame) keep the current value.
+namespace {
+struct InterpMatrix { u8 param; f32 m[4][4]; };
+std::vector<InterpMatrix> g_interpPrev;
+std::vector<InterpMatrix> g_interpCur;
+size_t g_interpIndex = 0;
+f32 g_interpT = 1.0f;
+}
+
+extern "C" void GLideN64_InterpNewFrame()
+{
+	g_interpPrev.swap(g_interpCur);
+	g_interpCur.clear();
+}
+
+extern "C" void GLideN64_InterpBeginDList(float t)
+{
+	g_interpT = t;
+	g_interpIndex = 0;
+}
+
+static void interpMatrix(f32 mtx[4][4], u8 param)
+{
+	const size_t k = g_interpIndex++;
+	if (k >= g_interpCur.size())
+		g_interpCur.resize(k + 1);
+	g_interpCur[k].param = param;
+	memcpy(g_interpCur[k].m, mtx, sizeof(g_interpCur[k].m));
+	if (g_interpT >= 1.0f || k >= g_interpPrev.size() || g_interpPrev[k].param != param)
+		return;
+	const f32 t = g_interpT;
+	for (int i = 0; i < 4; ++i)
+		for (int j = 0; j < 4; ++j)
+			mtx[i][j] = g_interpPrev[k].m[i][j] + (mtx[i][j] - g_interpPrev[k].m[i][j]) * t;
+}
